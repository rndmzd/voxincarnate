{
  "name": "voxincarnate",
  "productName": "Voxincarnate",
  "version": "0.3.1",
  "description": "A Windows talking-avatar studio with isolated assistant browser audio and transparent OBS output.",
  "author": "Voxincarnate contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "npm run setup && npm run build && electron .",
    "preview": "vite --host 127.0.0.1 --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test desktop/tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dist": "npm run setup && npm run check && node scripts/package.mjs --win nsis zip --x64 --publish never",
    "pack": "npm run setup && npm run build && node scripts/package.mjs --win --dir --x64 --publish never",
    "smoke": "npm run setup && npm run build && electron . --smoke-test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.voxincarnate.desktop",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "artwork/viseme-demo",
        "to": "artwork/viseme-demo",
        "filter": [
          "*.png",
          "README.md"
        ]
      },
      {
        "from": "overlays",
        "to": "legacy-artwork",
        "filter": [
          "mouth_open/*.png",
          "mouth_closed/*.png"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Voxincarnate-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
